Screen {
    background: $surface;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#banner {
    height: auto;
    background: $error 20%;
    color: $text;
    padding: 0 1;
}

#banner.hidden {
    display: none;
}

#filter-bar {
    height: 3;
    padding: 0 1;
}

#filter-bar Input {
    width: 1fr;
}

DataTable {
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $accent 40%;
}

#host-header {
    height: auto;
    padding: 0 1;
    background: $panel;
}

.panel-title {
    text-style: bold;
    padding: 0 1;
}

ModalScreen {
    align: center middle;
}

#confirm-box {
    width: 90;
    max-width: 90%;
    height: auto;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#confirm-box.safe {
    border: thick $accent;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}

#confirm-buttons Button {
    margin-left: 2;
}

#restart-log {
    height: 12;
    border: round $panel;
    margin-top: 1;
}

#query-bar {
    height: 3;
    padding: 0 1;
}

#query-bar Input#pattern {
    width: 2fr;
}

#query-bar Input.narrow {
    width: 9;
}

#query-bar Select {
    width: 14;
}

#results {
    height: 1fr;
    border: round $panel;
}

#counts {
    width: 46;
    border: round $panel;
}

#sources-tree {
    width: 34;
    border: round $panel;
}

.hidden {
    display: none;
}

#help-body {
    padding: 1 2;
}
